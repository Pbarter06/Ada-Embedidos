W system.storage_elements%s  s-stoele.adb	s-stoele.ali
Z system.tasking.restricted.stages%s  s-tarest.adb  s-tarest.ali
W uart%s		uart.adb		uart.ali  AD

U motor1%s		motor1.ads		2dac8a98 EE OO PK IL
